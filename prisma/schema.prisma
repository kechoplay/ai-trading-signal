generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Symbol {
  id          Int       @id @default(autoincrement())
  symbol      String    @unique
  name        String
  enabled     Boolean   @default(true)
  favorite    Boolean   @default(false)
  sort_order  Int       @default(999)
  created_at  DateTime  @default(now())

  analyses    AnalysisLog[]
  groupItems  SymbolGroupItem[]

  @@map("symbols")
}

model SymbolGroup {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  created_at DateTime          @default(now())

  items      SymbolGroupItem[]

  @@map("symbol_groups")
}

model SymbolGroupItem {
  id       Int         @id @default(autoincrement())
  group_id Int
  symbol   String

  group     SymbolGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  symbolRef Symbol      @relation(fields: [symbol], references: [symbol])

  @@unique([group_id, symbol])
  @@map("symbol_group_items")
}

model AnalysisLog {
  id              Int      @id @default(autoincrement())
  symbol          String
  analyzed_at     DateTime @default(now())
  duration_ms     Int
  setup           String?  @db.LongText
  reasoning       String?  @db.LongText
  analysis_type   String   @default("intraday")

  // Token tiêu thụ của lượt phân tích (null với bản ghi cũ / transport không báo cáo).
  input_tokens       Int?
  output_tokens      Int?
  cache_read_tokens  Int?
  cache_write_tokens Int?

  // Nguồn kích hoạt: scheduler (đồng hồ) | event (SetupWatcher) | api (bấm tay) | mcp.
  // null với bản ghi cũ (trước khi có cột này).
  trigger            String?

  symbolRef     Symbol   @relation(fields: [symbol], references: [symbol])

  @@index([symbol, analyzed_at])
  @@index([analysis_type, analyzed_at])
  @@map("analysis_logs")
}

model Setting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("settings")
}

model TradingSignal {
  id                  Int       @id @default(autoincrement())
  instrument          String
  action              String
  timeframe           String?
  analysis_type       String    @default("intraday")
  entry               Float?
  stop_loss           Float?
  take_profit         Float?
  risk_reward         Float?
  confidence          Int?
  current_price       Float?
  reasoning           String?  @db.LongText
  trend_bias          String?
  raw_ai_response     String?  @db.LongText
  indicators_snapshot String?  @db.LongText
  telegram_message_id String?
  sent_at             DateTime?
  analyze_at          DateTime?
  // Nguồn kích hoạt: scheduler | event | api | mcp (null với bản ghi cũ) — để so hiệu quả
  // tín hiệu do SetupWatcher kích hoạt với tín hiệu chạy theo đồng hồ.
  trigger             String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([instrument, created_at])
  @@index([analysis_type, created_at])
  @@map("trading_signals")
}

// Lịch sử SetupWatcher: mỗi bản ghi = một lần một hướng ĐỔI BƯỚC trong chuỗi
// sweep → BOS/CHoCH → retest (không ghi mỗi tick). Xem SetupWatcher.recordTransitions().
model SetupWatchEvent {
  id              Int      @id @default(autoincrement())
  symbol          String
  timeframe       String
  direction       String              // BUY | SELL
  stage           String              // NONE | SWEPT | CONFIRMED | RETEST
  prev_stage      String?             // null = lần đầu ghi nhận hướng này
  setup_key       String?             // định danh chuỗi (sweep + cú phá), null trước bước CONFIRMED
  price           Float
  bias            String?
  bias_ok         Boolean  @default(false)
  note            String   @db.Text
  detail          String?  @db.Text   // JSON { sweep, structure, zone }
  // Watcher đã gọi AI cho chuỗi này chưa + kết quả; skip_reason = vì sao RETEST mà không gọi.
  triggered       Boolean  @default(false)
  triggered_at    DateTime?           // lúc gọi AI — nạp lại cooldown/trần/ngày sau restart
  analysis_action String?
  skip_reason     String?
  created_at      DateTime @default(now())

  @@index([symbol, created_at])
  @@index([triggered, triggered_at])
  @@map("setup_watch_events")
}
