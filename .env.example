# ========== AI TRADING SIGNAL — Node.js ==========

# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/ai_trading_signal"

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# ─── Market Data ───────────────────────────────────────
# Provider: twelvedata | oanda
MARKET_PROVIDER=twelvedata

# Instrument — phải khớp với provider đang dùng:
#   TwelveData : XAU/USD
TRADING_INSTRUMENT=XAU/USD
TRADING_TIMEFRAMES=H4,H1,M15,M5
# Bộ khung riêng cho crypto (entry từ M15 — bỏ M5 vì crypto nhiễu hơn vàng).
# Áp dụng khi instrument là crypto và request không truyền timeframes riêng.
TRADING_CRYPTO_TIMEFRAMES=D,H4,H1,M15
# Số nến tính FACTS cho từng khung crypto (D context, H4 bias, H1 POI, M15 entry).
TRADING_CRYPTO_CANDLES_D=90
TRADING_CRYPTO_CANDLES_H4=120
TRADING_CRYPTO_CANDLES_H1=180
TRADING_CRYPTO_CANDLES_M15=200
# Số nến thô gửi model cho khung entry crypto (M15). Vàng (M5) dùng CLAUDE_RAW_CANDLES.
CLAUDE_RAW_CANDLES_CRYPTO=40
TRADING_CANDLES_COUNT=214
TRADING_CANDLES_H4=30
TRADING_CANDLES_H1=214
TRADING_CANDLES_M15=240
TRADING_CANDLES_M5=180
TRADING_CANDLES_M1=240
TRADING_MIN_RR=1.0

# Market hours — phân tích chỉ chạy trong giờ mở cửa
MARKET_HOURS_OPEN=6
MARKET_HOURS_CLOSE=22
MARKET_HOURS_TIMEZONE=Asia/Ho_Chi_Minh

# ─── Scheduler (tự phân tích theo chu kỳ) ──────────────
# Mốc chạy canh theo đồng hồ (…:00/:15/:30/:45 giờ VN) → phân tích ngay sau khi nến
# M15 đóng. Múi giờ dùng chung MARKET_HOURS_TIMEZONE. Trạng thái: GET /api/scheduler
# QUOTA: mỗi lượt tiêu ~50k input + ~12k output token; 15 phút × 8h–22h = 56 lượt/ngày,
# dùng chung hạn mức subscription với các session Claude Code → kiểm /usage trước khi
# hạ INTERVAL xuống dưới 15.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MIN=15
SCHEDULER_START_HOUR=8
SCHEDULER_END_HOUR=22
SCHEDULER_WEEKDAYS=1,2,3,4,5      # 1=T2 … 5=T6 (0=CN, 6=T7) — vàng nghỉ cuối tuần
SCHEDULER_SYMBOLS=                # trống = TRADING_INSTRUMENT; nhiều symbol chạy lần lượt
SCHEDULER_OFFSET_SEC=0            # lùi vài giây nếu provider trả nến cuối chậm

# ─── Kế hoạch ngày vàng + crypto (DailyPlanScheduler) ──────────
# Lập plan trong ngày (bias D/H4/H1, bản đồ mức giá, kịch bản BUY/SELL, lịch phiên) —
# KHÔNG ra lệnh. Mốc = START_HOUR, +INTERVAL_HOURS, … ≤ END_HOUR → mặc định 7h/11h/15h/19h
# T2–T6 giờ VN (4 mốc/ngày × số symbol lượt AI). Lưu analysis_type=daily_plan. Trạng thái:
# GET /api/daily-plan, chạy ngay: POST /api/daily-plan/run. Đụng lượt khác → chờ rồi thử lại.
# Symbol crypto tự dùng prompt plan crypto (LONG/SHORT, ngày UTC, funding/OI, BTC context);
# mỗi plan ≈ 5 request TwelveData (ETH thêm 2 cho BTC context).
DAILY_PLAN_ENABLED=true
DAILY_PLAN_START_HOUR=7
DAILY_PLAN_INTERVAL_HOURS=4
DAILY_PLAN_END_HOUR=22
DAILY_PLAN_WEEKDAYS=1,2,3,4,5
DAILY_PLAN_SYMBOLS=XAU/USD,BTC/USD,ETH/USD   # chạy lần lượt ở mỗi mốc (~3 phút/symbol)
DAILY_PLAN_TIMEFRAMES=D,H4,H1,M15
DAILY_PLAN_OFFSET_SEC=30
DAILY_PLAN_BUSY_RETRY_SEC=60
DAILY_PLAN_BUSY_MAX_WAIT_MIN=15
# Số nến LẤY VỀ (vàng: nến T7/CN đi ngang bị lọc sau đó → dư ~30%; crypto giữ nguyên) + range premium/discount D/H4
DAILY_PLAN_CANDLES_D=170
DAILY_PLAN_CANDLES_H4=160
DAILY_PLAN_CANDLES_H1=160
DAILY_PLAN_CANDLES_M15=96
DAILY_PLAN_RANGE_LOOKBACK_D=120
DAILY_PLAN_RANGE_LOOKBACK_H4=120
# Lịch phiên theo giờ New York (DST tự xử lý): rollover ngày, đóng cửa T6, mở cửa CN, range Á
DAILY_PLAN_ROLLOVER_NY_HOUR=17
DAILY_PLAN_CLOSE_FRI_NY_HOUR=17
DAILY_PLAN_OPEN_SUN_NY_HOUR=18
DAILY_PLAN_ASIA_START_NY_HOUR=20
DAILY_PLAN_ASIA_END_NY_HOUR=24

# Setup watcher — kích hoạt phân tích AI theo SỰ KIỆN (sweep → BOS/CHoCH có displacement
# → giá retest FVG/OB). Dò cơ học mỗi N phút, KHÔNG gọi AI; chỉ gọi Claude khi chuỗi tới
# bước retest. Dùng chung khung giờ/ngày với SCHEDULER_*. Mỗi lần kích hoạt tốn
# quota như một lượt phân tích → giới hạn bằng COOLDOWN + MAX_PER_DAY.
SETUP_WATCHER_ENABLED=true
SETUP_WATCHER_SYMBOLS=   # trống = SCHEDULER_SYMBOLS; mỗi symbol ≈ 180 request TwelveData/ngày
SETUP_WATCHER_INTERVAL_MIN=5
SETUP_WATCHER_TIMEFRAME=M15         # khung dò chuỗi
SETUP_WATCHER_BIAS_TIMEFRAME=H1     # bias khung lớn — hướng setup không được ngược
SETUP_WATCHER_REQUIRE_BIAS=true     # true = chặn khi NGƯỢC bias rõ ràng (NEUTRAL vẫn gọi AI); false = không chặn
SETUP_WATCHER_COOLDOWN_MIN=30
SETUP_WATCHER_MAX_PER_DAY=8          # trần chung mọi symbol; 0 = không giới hạn

# Ngưỡng nhận diện ICT (IctPreprocessor)
ICT_DISPLACEMENT_BODY_ATR=1.0       # thân nến phá ≥ N× ATR (hoặc để lại FVG) = displacement
ICT_SWEEP_REJECT_BARS=2             # số nến được phép để body close quay lại → vẫn là sweep
ICT_RETEST_INVALIDATE_ATR=0.25      # vùng retest chỉ "hỏng" khi body close xuyên mép xa quá N× ATR (0 = cũ)
ICT_RETEST_MERGE_OB_GAP_ATR=0.5     # gộp FVG + OB liền kề (cách ≤ N× ATR) thành 1 vùng; âm = tắt

# ─── Nhịp nhỏ / swing scalp (zigzag pivot, KHÔNG dùng AI) ──
# Dò điểm BUY/SELL theo từng nhịp nhỏ như indicator zigzag trên TradingView. Cơ học
# 100% → chạy vài ms, KHÔNG tiêu quota Claude. Gọi: GET /api/swing, nút "🔁 Nhịp nhỏ"
# trên dashboard, hoặc `npm run swing`.
# MIN_LEG_ATR là núm chính: cao → ít tín hiệu nhưng chỉ nhịp lớn; thấp → bắt nhịp nhỏ
# hơn, nhiễu nhiều hơn. Cột "Nhịp" trong báo cáo cho biết nên chỉnh về đâu.
SWING_TIMEFRAME=M5
SWING_CANDLES=300
SWING_PIVOT_LOOKBACK=2            # số nến mỗi bên để xác nhận đỉnh/đáy (2 = xác nhận sau 2 nến)
SWING_MIN_LEG_ATR=1.0             # nhịp nhỏ hơn ngần này × ATR bị coi là nhiễu, bỏ qua
SWING_SL_BUFFER_ATR=0.25          # đệm SL ra sau đỉnh/đáy pivot để không bị quét râu
SWING_TP_R=1,2,3                  # TP1/TP2/TP3 theo bội số R
SWING_EXIT_RULE=PARTIAL_BE        # luật thoát cho winrate/tổng R chính: TP1_FULL | PARTIAL_BE | TRAIL_PIVOT
SWING_ATR_PERIOD=14
SWING_STALE_BARS=6                # tín hiệu cũ hơn ngần này nến → coi như hết hiệu lực

# ─── Theo dõi kết quả lệnh (không gọi AI) ──────────────
# Cần bảng signal_outcomes (npx prisma db push trên server). Vàng tốn ~1 request TwelveData/lượt khi còn lệnh chưa chốt.
OUTCOME_TRACKER_ENABLED=true
OUTCOME_TRACKER_INTERVAL_MIN=15
OUTCOME_TRACKER_TIMEFRAME=M5
OUTCOME_FILL_WINDOW_MIN=180       # lệnh chờ quá ngần này phút chưa khớp → NO_FILL
OUTCOME_HOLD_MAX_HOURS=24         # đã khớp quá ngần này giờ chưa chạm TP1/SL → EXPIRED
OUTCOME_MARKET_FILL_TOL_R=0.1     # |entry − giá lúc phân tích| ≤ N × khoảng SL → coi là lệnh thị trường
OUTCOME_CANCEL_ON_TP_BEFORE_FILL=true  # giá chạm TP1 khi lệnh chờ chưa khớp → hủy (NO_FILL)
OUTCOME_DEDUP_ENTRY_TOL_R=0.25    # thống kê gộp tín hiệu trùng: entry lệch ≤ N × khoảng SL, cùng hướng, lệnh trước còn hiệu lực
OUTCOME_BACKFILL_DAYS=3
OUTCOME_MAX_CANDLES=1500

# ─── TwelveData ────────────────────────────────────────
# Đăng ký miễn phí: https://twelvedata.com (800 req/ngày)
# Nhiều key: phân cách phẩy (key1,key2). Key đầu hết credit ngày / sai key → tự chuyển key
# kế, 00:00 UTC (07:00 VN) quay lại key đầu.
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com
TWELVEDATA_MAX_REQUESTS_PER_MIN=8   # trần gói basic; request vượt sẽ CHỜ thay vì lỗi 429 (0 = tắt)

# ─── Binance Futures (sentiment cho crypto) ────────────
# API public, KHÔNG cần key. Cấp funding rate + open interest + BTC context cho
# phân tích crypto. Fail-soft: nếu lỗi/geo-block thì bỏ qua phần sentiment.
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
# Đặt 'false' để tắt hoàn toàn (không gọi Binance, không lấy BTC context).
CRYPTO_FUTURES_SENTIMENT=true
# Nguồn nến + giá crypto: 'binance' (/fapi/v1/klines — có volume, không tốn credit TwelveData;
# lỗi thì tự rơi về provider chính) hoặc 'provider' (TwelveData/OANDA như cũ, không volume).
CRYPTO_CANDLE_SOURCE=binance
# Volume tương đối "× TB" = volume nến / trung bình N nến đã đóng liền trước (chỉ crypto).
ICT_VOLUME_SMA_BARS=20
# Hộp range (sideway) trong FACTS: chuỗi swing gần nhất rộng ≤ MAX_WIDTH× ATR (và ≥ MIN_WIDTH×),
# kéo dài ≥ MIN_BARS nến, mỗi biên ≥ MIN_TOUCHES swing chạm (cách biên ≤ TOUCH_TOL× ATR).
ICT_RANGE_BOX_MAX_WIDTH_ATR=6
ICT_RANGE_BOX_MIN_WIDTH_ATR=1.5
ICT_RANGE_BOX_MIN_BARS=20
ICT_RANGE_BOX_MIN_TOUCHES=2
ICT_RANGE_BOX_TOUCH_TOL_ATR=0.5

# ─── Anthropic Claude ──────────────────────────────────
# Cách xác thực gọi Claude:
#   apikey       : dùng CLAUDE_API_KEY (console.anthropic.com) — tính phí theo token.
#   subscription : dùng subscription Pro/Max qua Claude Agent SDK — KHÔNG cần API key,
#                  tiêu quota gói (giới hạn cửa sổ 5h + trần tuần). Yêu cầu:
#                    1) npm install @anthropic-ai/claude-agent-sdk
#                    2) `claude setup-token` (trên máy có browser) → dán vào CLAUDE_CODE_OAUTH_TOKEN
AI_AUTH_MODE=apikey

# Lấy API key: https://console.anthropic.com (chỉ cần khi AI_AUTH_MODE=apikey)
# claude-opus-4-7    : mạnh nhất (mặc định)
# claude-sonnet-4-6  : nhanh hơn, rẻ hơn
# claude-haiku-4-5   : nhanh nhất, rẻ nhất
CLAUDE_API_KEY=
# Token subscription (chỉ cần khi AI_AUTH_MODE=subscription). Sinh bằng `claude setup-token`.
# GIỮ BÍ MẬT — đây là chìa khóa tài khoản Claude của bạn. Không commit.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-4-6
# Độ sâu suy luận: low | medium | high | max (Sonnet 4.6 / Opus 4.x).
# Code đã tính sẵn ICT facts nên bài toán nhẹ → 'medium' cân bằng tốc độ/chất lượng.
CLAUDE_EFFORT=medium
# Số nến thô gửi cho khung entry (M5/H4). Các khung khác chỉ gửi facts đã tính sẵn.
CLAUDE_RAW_CANDLES=60
# Số nến thô THEO KHUNG cho intraday vàng (prompt v3.1) — model cần hình dạng nến ở
# nhiều khung: nhóm A/B/C của H1 (hold dài), "nến M15 thân lớn" (Cổng 2.5), impulsive
# leg M5. H4 không có → chỉ gửi facts. Tùy chọn: bỏ trống = dùng default bên dưới.
CLAUDE_RAW_CANDLES_H1=40
CLAUDE_RAW_CANDLES_M15=20
CLAUDE_RAW_CANDLES_M5=60

# ─── Telegram Bot ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DISCUSSION_ID=
# Kênh riêng theo symbol (tùy chọn): SYMBOL:chatId[:discussionId], phân cách phẩy. Không ghi
# discussionId → tự dò nhóm discussion của kênh đó. Symbol không liệt kê → TELEGRAM_CHAT_ID.
TELEGRAM_CHANNELS_BY_SYMBOL=          # vd BTC/USD:-1004408769459,ETH/USD:-1003952719518

# ─── API Server ────────────────────────────────────────
PORT=3000
# Đặt key bất kỳ để bảo vệ mọi /api/* (kể cả /api/signals, /api/usage) và đăng nhập MCP (để trống = public)
API_SERVER_KEY=
# Số reverse proxy đứng trước server (vd 1 với nginx/Cloudflare Tunnel) để rate-limit đọc đúng IP client.
# Trống = không tin X-Forwarded-For. Đặt sai khi chạy sau proxy → mọi client dùng chung 1 IP (bị khoá chung).
TRUST_PROXY=
# Thử sai mật khẩu ở /authorize/submit quá số lần này trong cửa sổ (phút) → 429
AUTHORIZE_MAX_FAILURES=10
AUTHORIZE_WINDOW_MIN=15

APP_DOMAIN=